---
title: Catalog
layout: base.njk
---
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/photoswipe@5/dist/photoswipe.css">

<div class="category-pills" id="categoryPills"></div>

<div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
  <input type="text" class="form-control" id="searchInput" placeholder="Search products, sizes, price..." style="flex:1; min-width:200px;">
  <select class="form-select" id="sortSelect" style="width:auto;">
    <option value="">Sort</option>
    <option value="low">Price: Low to High</option>
    <option value="high">Price: High to Low</option>
  </select>
  <button class="btn btn-outline-primary btn-sm" type="button" onclick="openCartModal()">
    <i class="bi bi-cart3"></i> View Cart
  </button>
</div>

<div class="row" id="catalog">
  <div class="col-12 col-md-4 mb-4">
    <div class="skeleton-card">
      <div class="skeleton" style="aspect-ratio:1/1;"></div>
      <div class="skeleton skeleton-line" style="width: 70%;"></div>
      <div class="skeleton skeleton-line" style="width: 40%;"></div>
    </div>
  </div>
  <div class="col-12 col-md-4 mb-4 d-none d-md-block">
    <div class="skeleton-card">
      <div class="skeleton" style="aspect-ratio:1/1;"></div>
      <div class="skeleton skeleton-line" style="width: 70%;"></div>
      <div class="skeleton skeleton-line" style="width: 40%;"></div>
    </div>
  </div>
  <div class="col-12 col-md-4 mb-4 d-none d-md-block">
    <div class="skeleton-card">
      <div class="skeleton" style="aspect-ratio:1/1;"></div>
      <div class="skeleton skeleton-line" style="width: 70%;"></div>
      <div class="skeleton skeleton-line" style="width: 40%;"></div>
    </div>
  </div>
</div>

<!-- Shown only once the cart has at least one item -->
<div class="proceed-cart-btn" id="proceedCartBtn" onclick="window.location.href='/cart/'">
  Proceed To Cart
</div>

<!-- Cart preview modal (Bootstrap modal - allowed per design brief) -->
<div class="modal fade" id="cartModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-cart3"></i> Your Cart</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="cartContent"></div>
      <div class="modal-footer">
        <a href="/cart/" class="btn btn-primary btn-block">Proceed to Checkout</a>
      </div>
    </div>
  </div>
</div>

<script type="module">
  import PhotoSwipeLightbox from 'https://cdn.jsdelivr.net/npm/photoswipe@5/dist/photoswipe-lightbox.esm.js';

  // One scoped lightbox instance per product, so zooming into a product's
  // photos never lets you swipe into a different product's images.
  let lightboxInstances = [];

  window.initPhotoSwipe = function (productIds) {
    lightboxInstances.forEach(lb => lb.destroy());
    lightboxInstances = [];

    productIds.forEach(id => {
      const el = document.getElementById(`gallery-${id}`);
      if (!el) return;
      const lightbox = new PhotoSwipeLightbox({
        gallery: `#gallery-${id}`,
        children: '.pswp-gallery-item',
        pswpModule: () => import('https://cdn.jsdelivr.net/npm/photoswipe@5/dist/photoswipe.esm.js')
      });
      lightbox.init();
      lightboxInstances.push(lightbox);
    });
  };
</script>

<script>
  let products = [];
  let filteredProducts = [];
  let productMap = {};
  let cart = JSON.parse(localStorage.getItem("cart") || "{}");

  const catalogEl = document.getElementById("catalog");

  async function loadCatalog() {
    try {
      const res = await fetch("/api/products");
      products = await res.json();
      filteredProducts = products;
      productMap = {};
      products.forEach(p => productMap[p.id] = p);

      if (!Array.isArray(products) || products.length === 0) {
        catalogEl.innerHTML = `
          <div class="col-12">
            <div class="empty-state">
              <div class="empty-icon"><i class="bi bi-shop"></i></div>
              <p>No products here yet. Check back soon.</p>
            </div>
          </div>`;
        return;
      }

      renderCategoryPills();
      renderCatalog();
      restoreCart();
    } catch (err) {
      catalogEl.innerHTML = `<div class="col-12"><div class="alert alert-danger">Could not load products. Please refresh.</div></div>`;
      console.error(err);
    }
  }

  function buildGallery(p) {
    const photos = (p.photos && p.photos.length > 0) ? p.photos : ['https://placehold.co/600x600?text=No+Image'];
    const multi = photos.length > 1;

    const slides = photos.map(photo => `
      <div class="gallery-slide">
        <a href="${photo}" class="pswp-gallery-item" target="_blank" rel="noopener">
          <img src="${photo}" alt="${p.name}" loading="lazy"
               onerror="this.src='https://placehold.co/600x600?text=No+Image'">
        </a>
      </div>
    `).join("");

    const dots = multi ? `
      <div class="gallery-dots" id="dots-${p.id}">
        ${photos.map((_, i) => `<span class="dot ${i === 0 ? "active" : ""}"></span>`).join("")}
      </div>
    ` : "";

    const arrows = multi ? `
      <button type="button" class="gallery-arrow prev" onclick="scrollGallery(${p.id}, -1)" aria-label="Previous photo">‹</button>
      <button type="button" class="gallery-arrow next" onclick="scrollGallery(${p.id}, 1)" aria-label="Next photo">›</button>
    ` : "";

    return `
      <div class="gallery-wrap">
        <div class="gallery-track" id="gallery-${p.id}" ${multi ? `onscroll="onGalleryScroll(${p.id})"` : ""}>
          ${slides}
        </div>
        ${dots}
        ${arrows}
      </div>
    `;
  }

  function scrollGallery(id, direction) {
    const track = document.getElementById(`gallery-${id}`);
    if (!track) return;
    track.scrollBy({ left: direction * track.clientWidth, behavior: "smooth" });
  }

  function onGalleryScroll(id) {
    const track = document.getElementById(`gallery-${id}`);
    const dotsEl = document.getElementById(`dots-${id}`);
    if (!track || !dotsEl) return;
    const index = Math.round(track.scrollLeft / track.clientWidth);
    [...dotsEl.children].forEach((dot, i) => dot.classList.toggle("active", i === index));
  }

  function renderCatalog() {
    catalogEl.innerHTML = filteredProducts.map(p => `
      <div class="col-12 col-md-4 mb-4">
        <div class="product-card">
          ${buildGallery(p)}
          <div class="product-body" id="body_${p.id}">
            <h3 class="product-name">${p.name}</h3>
            ${buildProductControls(p)}
          </div>
        </div>
      </div>
    `).join("");

    if (window.initPhotoSwipe) window.initPhotoSwipe(filteredProducts.map(p => p.id));
    filteredProducts.forEach(p => refreshVariantDisplay(p.id));
  }

  // Builds the attribute dropdowns (if any) + price/stock display + qty
  // stepper for a single product. Simple products (no attributes) just get
  // a price and a qty stepper, no dropdowns.
  function buildProductControls(p) {
    const attrSelects = (p.attributes || []).map(attr => `
      <div class="form-field" style="margin-bottom:6px;">
        <label class="form-label" style="margin-bottom:2px;">${attr.name}</label>
        <select class="form-select form-select-sm" id="attr_${p.id}_${attr.name}" onchange="refreshVariantDisplay(${p.id})">
          ${attr.values.map(v => `<option value="${v}">${v}</option>`).join("")}
        </select>
      </div>
    `).join("");

    return `
      ${attrSelects}
      <div style="font-size:14px; font-weight:700; margin: 4px 0;" id="variantPrice_${p.id}">₹0</div>
      <div style="font-size:12px; color:var(--color-text-muted); margin-bottom:6px;" id="variantStock_${p.id}"></div>
      <div class="qty-stepper">
        <button class="btn btn-outline-primary" type="button" onclick="changeQty(${p.id},-1)">−</button>
        <input type="number" class="form-control qty-input" id="qty_${p.id}" value="0" min="0" oninput="manualQty(${p.id})">
        <button class="btn btn-outline-primary" type="button" onclick="changeQty(${p.id},1)">+</button>
      </div>
    `;
  }

  // Finds the variant matching the currently-selected attribute dropdowns
  // for a product (or the single variant, for a simple product).
  function resolveVariant(p) {
    if (!p.attributes || p.attributes.length === 0) {
      return p.variants[0];
    }
    const selected = {};
    p.attributes.forEach(attr => {
      const el = document.getElementById(`attr_${p.id}_${attr.name}`);
      if (el) selected[attr.name] = el.value;
    });
    return p.variants.find(v =>
      Object.keys(selected).every(key => v.values[key] === selected[key])
    );
  }

  function variantLabel(variant) {
    if (!variant || !variant.values) return "";
    return Object.values(variant.values).join(" / ");
  }

  function refreshVariantDisplay(productId) {
    const p = productMap[productId];
    const variant = resolveVariant(p);
    const priceEl = document.getElementById(`variantPrice_${productId}`);
    const stockEl = document.getElementById(`variantStock_${productId}`);
    const qtyInput = document.getElementById(`qty_${productId}`);

    if (!variant) {
      priceEl.textContent = "Unavailable";
      stockEl.textContent = "This combination is not available.";
      qtyInput.disabled = true;
      qtyInput.value = 0;
      return;
    }

    priceEl.textContent = "₹" + variant.price;

    if (variant.stock <= 0) {
      stockEl.textContent = "Out of stock";
      stockEl.style.color = "var(--color-danger)";
      qtyInput.disabled = true;
    } else {
      stockEl.textContent = variant.stock <= 5 ? `Only ${variant.stock} left` : "In stock";
      stockEl.style.color = "var(--color-text-muted)";
      qtyInput.disabled = false;
    }

    // Reflect however much of THIS variant is already in the cart
    qtyInput.value = (cart[variant.id] && cart[variant.id].qty) || 0;
  }

  function changeQty(productId, delta) {
    const qtyInput = document.getElementById(`qty_${productId}`);
    qtyInput.value = Math.max(0, Number(qtyInput.value) + delta);
    manualQty(productId);
  }

  function manualQty(productId) {
    const qtyInput = document.getElementById(`qty_${productId}`);
    if (qtyInput.value < 0) qtyInput.value = 0;

    const p = productMap[productId];
    const variant = resolveVariant(p);
    if (!variant) return;

    const qty = Number(qtyInput.value);

    if (qty > 0) {
      cart[variant.id] = {
        productId: p.id,
        variantId: variant.id,
        name: p.name,
        valuesLabel: variantLabel(variant),
        photo: (p.photos && p.photos[0]) || "",
        price: variant.price,
        qty
      };
    } else {
      delete cart[variant.id];
    }

    localStorage.setItem("cart", JSON.stringify(cart));
    document.dispatchEvent(new Event("cart:updated"));
    refreshProceedButton();
  }

  function restoreCart() {
    document.dispatchEvent(new Event("cart:updated"));
    refreshProceedButton();
  }

  function refreshProceedButton() {
    const btn = document.getElementById("proceedCartBtn");
    if (Object.keys(cart).length > 0) {
      btn.classList.add("visible");
    } else {
      btn.classList.remove("visible");
    }
  }

  // ---- Cart modal ----
  let cartModalInstance;

  function openCartModal() {
    const cartContent = document.getElementById("cartContent");

    if (Object.keys(cart).length === 0) {
      cartContent.innerHTML = `<div class="empty-state"><div class="empty-icon"><i class="bi bi-cart"></i></div><p>Your cart is empty.</p></div>`;
    } else {
      let grandTotal = 0;
      cartContent.innerHTML = Object.entries(cart).map(([variantId, c]) => {
        grandTotal += c.price * c.qty;
        const label = c.valuesLabel ? ` (${c.valuesLabel})` : "";
        return `
          <div class="d-flex justify-content-between align-items-center py-2" style="border-bottom:1px solid var(--color-border);">
            <div>
              <div style="font-weight:600; font-size:14px;">${c.name}${label}</div>
              <div style="font-size:12px; color:var(--color-text-muted);">Qty ${c.qty} · ₹${c.price * c.qty}</div>
            </div>
            <button class="btn btn-secondary btn-sm" onclick="deleteItem('${variantId}')"><i class="bi bi-trash"></i></button>
          </div>`;
      }).join("") + `
        <div class="d-flex justify-content-between align-items-center pt-3">
          <strong>Grand Total</strong>
          <strong>₹${grandTotal}</strong>
        </div>`;
    }

    const modalEl = document.getElementById("cartModal");
    if (!cartModalInstance) cartModalInstance = new bootstrap.Modal(modalEl);
    cartModalInstance.show();
  }

  function deleteItem(variantId) {
    delete cart[variantId];
    localStorage.setItem("cart", JSON.stringify(cart));
    document.dispatchEvent(new Event("cart:updated"));
    refreshProceedButton();
    // Refresh whichever product card this variant belongs to, if visible
    filteredProducts.forEach(p => {
      if (p.variants.some(v => String(v.id) === String(variantId))) refreshVariantDisplay(p.id);
    });
    openCartModal();
  }

  // ---- Category pills ----
  let activeCategory = "All";

  function renderCategoryPills() {
    const categories = ["All", ...new Set(products.flatMap(p => (p.categories && p.categories.length > 0) ? p.categories : []))];
    const el = document.getElementById("categoryPills");
    el.innerHTML = categories.map(c => `
      <button type="button" class="category-pill ${c === activeCategory ? "active" : ""}" onclick="selectCategory('${c.replace(/'/g, "\\'")}')">${c}</button>
    `).join("");
  }

  function selectCategory(category) {
    activeCategory = category;
    renderCategoryPills();
    applyFilters();
  }

  // ---- Search + category + sort, combined ----
  let searchTimeout;
  document.getElementById("searchInput").addEventListener("input", function () {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(applyFilters, 300);
  });

  document.getElementById("sortSelect").addEventListener("change", applyFilters);

  function applyFilters() {
    const query = document.getElementById("searchInput").value.toLowerCase();
    const sortValue = document.getElementById("sortSelect").value;

    filteredProducts = products.filter(p => {
      const matchesCategory = activeCategory === "All" || (p.categories && p.categories.includes(activeCategory));
      const matchesSearch = !query ||
        p.name.toLowerCase().includes(query) ||
        (p.variants || []).some(v => Object.values(v.values).some(val => val.toLowerCase().includes(query))) ||
        (p.variants || []).some(v => v.price.toString().includes(query));
      return matchesCategory && matchesSearch;
    });

    if (sortValue === "low") filteredProducts.sort((a, b) => getMinPrice(a) - getMinPrice(b));
    if (sortValue === "high") filteredProducts.sort((a, b) => getMinPrice(b) - getMinPrice(a));

    renderCatalog();
    restoreCart();
  }

  function getMinPrice(product) {
    return Math.min(...(product.variants || []).map(v => v.price));
  }

  loadCatalog();
</script>
