---
title: Admin Dashboard
layout: admin-base.njk
---

<!-- ============ Dashboard ============ -->
<section class="admin-section" id="section-dashboard">
  <h2>Today's Orders</h2>
  <p style="font-size:13px; color:var(--color-text-muted); margin-top:-8px;" id="dashboard-date"></p>

  <div class="stat-grid">
    <div class="stat-card stat-total">
      <div class="stat-label">Total</div>
      <div class="stat-value" id="stat-total">0</div>
    </div>
    <div class="stat-card stat-paid">
      <div class="stat-label">Paid</div>
      <div class="stat-value" id="stat-paid">₹0</div>
    </div>
    <div class="stat-card stat-unpaid">
      <div class="stat-label">Unpaid</div>
      <div class="stat-value" id="stat-unpaid">₹0</div>
    </div>
    <div class="stat-card stat-cancelled">
      <div class="stat-label">Cancelled</div>
      <div class="stat-value" id="stat-cancelled">₹0</div>
    </div>
  </div>
  <p style="font-size:12px; color:var(--color-text-faint); margin-top:var(--space-3);">
    Updates automatically every 30 seconds. "Paid" includes Confirmed, Shipped, and Delivered orders.
  </p>
</section>

<!-- ============ Products ============ -->
<section class="admin-section" id="section-products">
  <h2>Categories</h2>
  <div class="surface-card">
    <div class="d-flex gap-2 mb-3">
      <input type="text" class="form-control" id="new-category-name" placeholder="New category name">
      <button class="btn btn-primary" type="button" onclick="addCategory()">Add</button>
    </div>
    <div id="category-list" class="d-flex flex-wrap gap-2"></div>
  </div>

  <h2 style="margin-top: var(--space-5);">Add Product</h2>
  <form id="add-form" class="surface-card">
    <div class="form-field">
      <label class="form-label" for="p-name">Product name</label>
      <input type="text" class="form-control" id="p-name" required>
    </div>
    <div class="form-field">
      <label class="form-label" for="p-photo1">Photo URL 1 (main image)</label>
      <input type="text" class="form-control" id="p-photo1" required>
    </div>
    <div class="form-field">
      <label class="form-label" for="p-photo2">Photo URL 2 (optional)</label>
      <input type="text" class="form-control" id="p-photo2">
    </div>
    <div class="form-field">
      <label class="form-label" for="p-photo3">Photo URL 3 (optional)</label>
      <input type="text" class="form-control" id="p-photo3">
    </div>
    <div class="form-field">
      <label class="form-label">Categories</label>
      <div id="p-category-checkboxes" class="d-flex flex-wrap gap-2"></div>
    </div>
    <div class="row g-2">
      <div class="col-6 form-field">
        <label class="form-label" for="p-stock">Stock quantity</label>
        <input type="number" class="form-control" id="p-stock" min="0" value="0">
      </div>
      <div class="col-6 form-field">
        <label class="form-label" for="p-gst">GST %</label>
        <input type="number" class="form-control" id="p-gst" min="0" max="28" step="0.1" value="0">
      </div>
    </div>
    <div class="form-field">
      <label class="form-label" for="p-sizes">Sizes (JSON)</label>
      <input type="text" class="form-control" id="p-sizes" placeholder='{"S":100,"M":120}' required>
    </div>
    <button type="submit" class="btn btn-primary btn-block">Add Product</button>
  </form>
  <div id="add-result" style="margin-top: var(--space-2);"></div>

  <h2 style="margin-top: var(--space-5);">Products</h2>
  <div class="bulk-actions-bar" id="products-bulk-bar">
    <span id="products-selected-count">0 selected</span>
    <button class="btn btn-danger btn-sm" onclick="deleteSelectedProducts()"><i class="bi bi-trash"></i> Delete Selected</button>
  </div>
  <div id="product-list">
    <div class="skeleton skeleton-line" style="height:60px;"></div>
  </div>
  <div id="products-pagination"></div>
</section>

<!-- ============ Orders ============ -->
<section class="admin-section" id="section-orders">
  <h2>Orders</h2>
  <div class="d-flex gap-2 mb-3 flex-wrap">
    <input type="text" class="form-control" id="orderSearchInput" placeholder="Search by Order ID, email, name, amount..." style="flex:1; min-width:200px;">
    <button class="btn btn-secondary" type="button" onclick="clearOrderSearch()">Clear</button>
  </div>
  <div class="d-flex gap-2 mb-3 flex-wrap align-items-end">
    <div>
      <label class="form-label" for="orderFromDate">From date</label>
      <input type="date" class="form-control" id="orderFromDate">
    </div>
    <div>
      <label class="form-label" for="orderToDate">To date</label>
      <input type="date" class="form-control" id="orderToDate">
    </div>
    <button class="btn btn-primary btn-sm" type="button" onclick="applyOrderFilters()">Apply</button>
    <button class="btn btn-secondary btn-sm" type="button" onclick="clearDateFilter()">Clear Dates</button>
  </div>
  <div class="bulk-actions-bar" id="orders-bulk-bar">
    <span id="orders-selected-count">0 selected</span>
    <button class="btn btn-danger btn-sm" onclick="deleteSelectedOrders()"><i class="bi bi-trash"></i> Delete Selected</button>
  </div>
  <div id="order-list">
    <div class="skeleton skeleton-line" style="height:60px;"></div>
  </div>
  <div id="orders-pagination"></div>

  <div class="surface-card" style="margin-top: var(--space-4); font-size:13px;">
    <strong>About order statuses:</strong>
    <div class="d-flex gap-3 flex-wrap" style="margin-top: var(--space-2);">
      <span><span class="status-dot" data-status="UNPAID"></span> Unpaid - payment not yet received</span>
      <span><span class="status-dot" data-status="CONFIRMED"></span> Confirmed - order accepted</span>
      <span><span class="status-dot" data-status="SHIPPED"></span> Shipped - on the way</span>
      <span><span class="status-dot" data-status="DELIVERED"></span> Delivered - completed</span>
      <span><span class="status-dot" data-status="CANCELLED"></span> Cancelled</span>
    </div>
    <p style="color:var(--color-text-muted); margin: var(--space-2) 0 0;">
      Click any order row to see full details, email an invoice, show a payment QR code, or send a WhatsApp reminder.
    </p>
  </div>
</section>

<!-- ============ Settings ============ -->
<section class="admin-section" id="section-settings">
  <h2>Store Settings</h2>
  <form id="settings-form" class="surface-card">
    <div class="form-field">
      <label class="form-label" for="s-name">Store name</label>
      <input type="text" class="form-control" id="s-name">
    </div>
    <div class="form-field">
      <label class="form-label" for="s-address">Address</label>
      <input type="text" class="form-control" id="s-address">
    </div>
    <div class="row g-2">
      <div class="col-6 form-field">
        <label class="form-label" for="s-gstin">GSTIN</label>
        <input type="text" class="form-control" id="s-gstin">
      </div>
      <div class="col-6 form-field">
        <label class="form-label" for="s-mobile">Mobile</label>
        <input type="text" class="form-control" id="s-mobile">
      </div>
    </div>
    <div class="form-field">
      <label class="form-label" for="s-email">Contact email</label>
      <input type="email" class="form-control" id="s-email">
    </div>

    <hr>
    <p style="font-size:13px; color:var(--color-text-muted);">Stock is deducted when an order is Confirmed (not when placed), and restored automatically if a Confirmed/Shipped/Delivered order is Cancelled.</p>

    <div class="form-field d-flex align-items-center justify-content-between">
      <label class="form-label" for="s-inventory" style="margin:0;">Enable Inventory Tracking</label>
      <input type="checkbox" id="s-inventory" style="width:20px; height:20px;">
    </div>
    <div class="form-field d-flex align-items-center justify-content-between">
      <label class="form-label" for="s-gst" style="margin:0;">Enable GST</label>
      <input type="checkbox" id="s-gst" style="width:20px; height:20px;">
    </div>
    <p style="font-size:12px; color:var(--color-text-muted); margin-top:-8px;">GST rate is set per product (in Add/Edit Product) - this just switches GST on or off storewide.</p>

    <button type="submit" class="btn btn-primary btn-block">Save Settings</button>
  </form>
  <div id="settings-result" style="margin-top: var(--space-2);"></div>
</section>

<!-- ============ Help ============ -->
<section class="admin-section" id="section-help">
  <h2>Help</h2>
  <div class="surface-card stack-md">
    <div>
      <strong>Adding a product</strong>
      <p style="margin:0;">Fill in the name, a photo URL, and sizes as JSON, e.g. <code>{"S":100,"M":120}</code>.</p>
    </div>
    <div>
      <strong>Managing orders</strong>
      <p style="margin:0;">Click any order row to see full details. Use the status dropdown to update it as you process the order.</p>
    </div>
    <div>
      <strong>Dashboard</strong>
      <p style="margin:0;">Shows a live snapshot of today's orders, split into Paid, Unpaid, and Cancelled totals.</p>
    </div>
    <div>
      <strong>Need more help?</strong>
      <p style="margin:0;">Email <a href="mailto:{{ site.supportEmail }}">{{ site.supportEmail }}</a> or call {{ site.supportPhone }}.</p>
    </div>
  </div>
</section>

<!-- Edit Product Modal -->
<div class="modal fade" id="editProductModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-pencil"></i> Edit Product</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="edit-p-id">
        <div class="form-field">
          <label class="form-label" for="edit-p-name">Product name</label>
          <input type="text" class="form-control" id="edit-p-name" placeholder="e.g. Colgate Salt">
        </div>
        <div class="form-field">
          <label class="form-label" for="edit-p-photo1">Photo URL 1 (main image)</label>
          <input type="text" class="form-control" id="edit-p-photo1" placeholder="https://...">
        </div>
        <div class="form-field">
          <label class="form-label" for="edit-p-photo2">Photo URL 2 (optional)</label>
          <input type="text" class="form-control" id="edit-p-photo2" placeholder="https://...">
        </div>
        <div class="form-field">
          <label class="form-label" for="edit-p-photo3">Photo URL 3 (optional)</label>
          <input type="text" class="form-control" id="edit-p-photo3" placeholder="https://...">
        </div>
        <div class="form-field">
          <label class="form-label">Categories</label>
          <div id="edit-p-category-checkboxes" class="d-flex flex-wrap gap-2"></div>
        </div>
        <div class="row g-2">
          <div class="col-6 form-field">
            <label class="form-label" for="edit-p-stock">Stock quantity</label>
            <input type="number" class="form-control" id="edit-p-stock" min="0">
          </div>
          <div class="col-6 form-field">
            <label class="form-label" for="edit-p-gst">GST %</label>
            <input type="number" class="form-control" id="edit-p-gst" min="0" max="28" step="0.1">
          </div>
        </div>
        <div class="form-field">
          <label class="form-label" for="edit-p-sizes">Sizes (JSON)</label>
          <input type="text" class="form-control" id="edit-p-sizes" placeholder='{"S":100,"M":120}'>
        </div>
        <div id="edit-p-result"></div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-danger" type="button" onclick="deleteProductFromModal()"><i class="bi bi-trash"></i> Delete</button>
        <button class="btn btn-primary" type="button" onclick="saveProductEdit()">Save Changes</button>
      </div>
    </div>
  </div>
</div>

<!-- Order Details Modal -->
<div class="modal fade" id="orderModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-scrollable modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Order Details</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="orderModalBody"></div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<script>
  const PAGE_SIZE = 10;
  let paginationCallbacks = {};

  function renderPagination(containerId, totalItems, currentPage, onChange) {
    paginationCallbacks[containerId] = onChange;
    const totalPages = Math.max(1, Math.ceil(totalItems / PAGE_SIZE));
    const el = document.getElementById(containerId);
    if (!el) return;
    if (totalPages <= 1) { el.innerHTML = ""; return; }

    let html = `<div class="pagination-nav">`;
    html += `<button class="btn btn-secondary btn-sm" ${currentPage === 1 ? "disabled" : ""} onclick="__paginate('${containerId}',${currentPage - 1})">‹ Prev</button>`;
    for (let i = 1; i <= totalPages; i++) {
      html += `<button class="btn btn-sm ${i === currentPage ? "btn-primary" : "btn-secondary"}" onclick="__paginate('${containerId}',${i})">${i}</button>`;
    }
    html += `<button class="btn btn-secondary btn-sm" ${currentPage === totalPages ? "disabled" : ""} onclick="__paginate('${containerId}',${currentPage + 1})">Next ›</button>`;
    html += `</div>`;
    el.innerHTML = html;
  }

  function __paginate(containerId, page) {
    if (paginationCallbacks[containerId]) paginationCallbacks[containerId](page);
  }

  let allProducts = [];
  let allOrders = [];
  let editProductModalInstance, orderModalInstance;

  // ---- Dashboard ----
  window.loadDashboard = async function () {
    document.getElementById("dashboard-date").textContent = new Date().toDateString();

    const res = await fetch("/api/admin/orders");
    const orders = await res.json();
    if (!Array.isArray(orders)) return;

    const today = new Date().toDateString();
    const todayOrders = orders.filter(o => new Date(o.date).toDateString() === today);

    const paidStatuses = ["CONFIRMED", "SHIPPED", "DELIVERED"];
    const paidAmount = todayOrders.filter(o => paidStatuses.includes(o.status)).reduce((s, o) => s + o.amount, 0);
    const unpaidAmount = todayOrders.filter(o => o.status === "UNPAID").reduce((s, o) => s + o.amount, 0);
    const cancelledAmount = todayOrders.filter(o => o.status === "CANCELLED").reduce((s, o) => s + o.amount, 0);

    document.getElementById("stat-total").textContent = todayOrders.length;
    document.getElementById("stat-paid").textContent = "₹" + paidAmount.toLocaleString("en-IN");
    document.getElementById("stat-unpaid").textContent = "₹" + unpaidAmount.toLocaleString("en-IN");
    document.getElementById("stat-cancelled").textContent = "₹" + cancelledAmount.toLocaleString("en-IN");
  };
  setInterval(() => window.loadDashboard(), 30000);

  // ---- Categories ----
  let allCategories = [];

  async function loadCategories() {
    const res = await fetch("/api/admin/categories");
    allCategories = await res.json();
    renderCategoryList();
    renderCategoryCheckboxes("p-category-checkboxes", []);
  }

  function renderCategoryList() {
    const el = document.getElementById("category-list");
    if (!Array.isArray(allCategories) || allCategories.length === 0) {
      el.innerHTML = `<span style="font-size:13px; color:var(--color-text-muted);">No categories yet - add one above.</span>`;
      return;
    }
    el.innerHTML = allCategories.map(c => `
      <span class="badge badge-neutral" style="display:inline-flex; align-items:center; gap:6px; padding:8px 12px;">
        ${c.name}
        <button onclick="deleteCategory(${c.id})" style="border:none; background:none; color:var(--color-danger); cursor:pointer; font-size:14px; line-height:1;">&times;</button>
      </span>
    `).join("");
  }

  async function addCategory() {
    const input = document.getElementById("new-category-name");
    const name = input.value.trim();
    if (!name) return;

    await fetch("/api/admin/categories", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ name })
    });
    input.value = "";
    await loadCategories();
  }

  async function deleteCategory(id) {
    if (!confirm("Delete this category? Products in it will be unassigned from it.")) return;
    await fetch("/api/admin/categories", {
      method: "DELETE",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ id })
    });
    await loadCategories();
    loadProducts();
  }

  function renderCategoryCheckboxes(containerId, selectedIds) {
    const el = document.getElementById(containerId);
    if (!el) return;
    if (!Array.isArray(allCategories) || allCategories.length === 0) {
      el.innerHTML = `<span style="font-size:13px; color:var(--color-text-muted);">No categories yet - add one in Categories above.</span>`;
      return;
    }
    el.innerHTML = allCategories.map(c => `
      <label style="display:flex; align-items:center; gap:6px; font-size:13px; background:var(--color-surface-sunken); padding:6px 10px; border-radius: var(--radius-sm); cursor:pointer;">
        <input type="checkbox" class="category-checkbox" value="${c.id}" ${selectedIds.includes(c.id) ? "checked" : ""}>
        ${c.name}
      </label>
    `).join("");
  }

  function getSelectedCategoryIds(containerId) {
    return [...document.querySelectorAll(`#${containerId} .category-checkbox:checked`)].map(cb => Number(cb.value));
  }

  // ---- Products ----
  let productsPage = 1;

  async function loadProducts() {
    const res = await fetch("/api/admin/products");
    allProducts = await res.json();
    productsPage = 1;
    renderProductsTable();
  }

  function renderProductsTable() {
    const el = document.getElementById("product-list");

    if (!Array.isArray(allProducts) || allProducts.length === 0) {
      el.innerHTML = `<div class="empty-state"><i class="bi bi-box-seam empty-icon"></i><p>No products yet.</p></div>`;
      document.getElementById("products-pagination").innerHTML = "";
      return;
    }

    const totalPages = Math.max(1, Math.ceil(allProducts.length / PAGE_SIZE));
    if (productsPage > totalPages) productsPage = totalPages;
    const start = (productsPage - 1) * PAGE_SIZE;
    const pageItems = allProducts.slice(start, start + PAGE_SIZE);

    el.innerHTML = `
      <table class="table-app">
        <thead><tr>
          <th><input type="checkbox" class="select-checkbox" onchange="toggleAllProducts(this.checked)"></th>
          <th>Image</th><th>Name</th><th>Categories</th><th>Stock</th><th>GST%</th><th>Sizes</th><th>Actions</th>
        </tr></thead>
        <tbody>
          ${pageItems.map(p => `
            <tr>
              <td data-label="Select"><input type="checkbox" class="select-checkbox product-checkbox" value="${p.id}" onchange="updateProductsBulkBar()"></td>
              <td data-label="Image"><img class="product-thumb" src="${(p.photos && p.photos[0]) || ''}" alt="${p.name}" onerror="this.src='https://placehold.co/100x100?text=No+Image'"></td>
              <td data-label="Name">${p.name}</td>
              <td data-label="Categories">${(p.categories || []).map(c => c.name).join(", ") || "-"}</td>
              <td data-label="Stock">${p.stock ?? 0}</td>
              <td data-label="GST%">${p.gstPercent ?? 0}</td>
              <td data-label="Sizes">${JSON.stringify(p.sizes)}</td>
              <td data-label="Actions">
                <button class="btn btn-secondary btn-sm" onclick="openEditProduct(${p.id})"><i class="bi bi-pencil"></i></button>
                <button class="btn btn-danger btn-sm" onclick="deleteProduct(${p.id})"><i class="bi bi-trash"></i></button>
              </td>
            </tr>
          `).join("")}
        </tbody>
      </table>
    `;
    updateProductsBulkBar();
    renderPagination("products-pagination", allProducts.length, productsPage, (p) => { productsPage = p; renderProductsTable(); });
  }

  function toggleAllProducts(checked) {
    document.querySelectorAll(".product-checkbox").forEach(cb => cb.checked = checked);
    updateProductsBulkBar();
  }

  function updateProductsBulkBar() {
    const checked = document.querySelectorAll(".product-checkbox:checked");
    const bar = document.getElementById("products-bulk-bar");
    document.getElementById("products-selected-count").textContent = checked.length + " selected";
    bar.classList.toggle("visible", checked.length > 0);
  }

  async function deleteSelectedProducts() {
    const ids = [...document.querySelectorAll(".product-checkbox:checked")].map(cb => Number(cb.value));
    if (ids.length === 0) return;
    if (!confirm(`Delete ${ids.length} selected product(s)?`)) return;

    await fetch("/api/admin/products", {
      method: "DELETE",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ ids })
    });
    loadProducts();
  }

  function openEditProduct(id) {
    const p = allProducts.find(x => x.id === id);
    if (!p) return;
    const photos = p.photos || [];
    document.getElementById("edit-p-id").value = p.id;
    document.getElementById("edit-p-name").value = p.name;
    document.getElementById("edit-p-photo1").value = photos[0] || "";
    document.getElementById("edit-p-photo2").value = photos[1] || "";
    document.getElementById("edit-p-photo3").value = photos[2] || "";
    document.getElementById("edit-p-stock").value = p.stock ?? 0;
    document.getElementById("edit-p-gst").value = p.gstPercent ?? 0;
    document.getElementById("edit-p-sizes").value = JSON.stringify(p.sizes);
    document.getElementById("edit-p-result").innerHTML = "";
    renderCategoryCheckboxes("edit-p-category-checkboxes", (p.categories || []).map(c => c.id));

    const modalEl = document.getElementById("editProductModal");
    if (!editProductModalInstance) editProductModalInstance = new bootstrap.Modal(modalEl);
    editProductModalInstance.show();
  }

  async function saveProductEdit() {
    const resultEl = document.getElementById("edit-p-result");
    let sizes;
    try {
      sizes = JSON.parse(document.getElementById("edit-p-sizes").value);
    } catch {
      resultEl.innerHTML = `<div class="alert alert-danger">Sizes must be valid JSON.</div>`;
      return;
    }

    const photos = [
      document.getElementById("edit-p-photo1").value,
      document.getElementById("edit-p-photo2").value,
      document.getElementById("edit-p-photo3").value
    ].filter(Boolean);

    const res = await fetch("/api/admin/products", {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        id: Number(document.getElementById("edit-p-id").value),
        name: document.getElementById("edit-p-name").value,
        photos,
        sizes,
        stock: Number(document.getElementById("edit-p-stock").value) || 0,
        gstPercent: Number(document.getElementById("edit-p-gst").value) || 0,
        categoryIds: getSelectedCategoryIds("edit-p-category-checkboxes")
      })
    });
    const data = await res.json();

    if (data.success) {
      editProductModalInstance.hide();
      loadProducts();
    } else {
      resultEl.innerHTML = `<div class="alert alert-danger">${data.error || "Could not save"}</div>`;
    }
  }

  async function deleteProductFromModal() {
    const id = Number(document.getElementById("edit-p-id").value);
    if (!confirm("Delete this product?")) return;
    await fetch("/api/admin/products", {
      method: "DELETE",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ id })
    });
    editProductModalInstance.hide();
    loadProducts();
  }

  async function deleteProduct(id) {
    if (!confirm("Delete this product?")) return;
    await fetch("/api/admin/products", {
      method: "DELETE",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ id })
    });
    loadProducts();
  }

  document.getElementById("add-form").addEventListener("submit", async (e) => {
    e.preventDefault();
    const resultEl = document.getElementById("add-result");

    let sizes;
    try {
      sizes = JSON.parse(document.getElementById("p-sizes").value);
    } catch {
      resultEl.innerHTML = `<div class="alert alert-danger">Sizes must be valid JSON, e.g. {"S":100,"M":120}</div>`;
      return;
    }

    const photos = [
      document.getElementById("p-photo1").value,
      document.getElementById("p-photo2").value,
      document.getElementById("p-photo3").value
    ].filter(Boolean);

    const res = await fetch("/api/admin/products", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        name: document.getElementById("p-name").value,
        photos,
        sizes,
        stock: Number(document.getElementById("p-stock").value) || 0,
        gstPercent: Number(document.getElementById("p-gst").value) || 0,
        categoryIds: getSelectedCategoryIds("p-category-checkboxes")
      })
    });
    const data = await res.json();

    if (data.success) {
      resultEl.innerHTML = `<div class="alert alert-success">Product added.</div>`;
      document.getElementById("add-form").reset();
      renderCategoryCheckboxes("p-category-checkboxes", []);
      loadProducts();
    } else {
      resultEl.innerHTML = `<div class="alert alert-danger">${data.error || "unknown error"}</div>`;
    }
  });

  // ---- Orders ----
  async function loadOrders() {
    const res = await fetch("/api/admin/orders");
    allOrders = await res.json();
    ordersPage = 1;
    applyOrderFilters();
  }

  let lastOrdersView = [];
  let ordersPage = 1;

  function getFilteredOrders() {
    const q = document.getElementById("orderSearchInput").value.toLowerCase();
    const fromDate = document.getElementById("orderFromDate").value;
    const toDate = document.getElementById("orderToDate").value;

    return allOrders.filter(o => {
      const matchesSearch = !q ||
        o.order_id.toLowerCase().includes(q) ||
        o.customer.email.toLowerCase().includes(q) ||
        o.customer.name.toLowerCase().includes(q) ||
        o.amount.toString().includes(q);

      const orderDate = o.date.slice(0, 10); // YYYY-MM-DD
      const matchesFrom = !fromDate || orderDate >= fromDate;
      const matchesTo = !toDate || orderDate <= toDate;

      return matchesSearch && matchesFrom && matchesTo;
    });
  }

  function applyOrderFilters() {
    ordersPage = 1;
    renderOrdersTable(getFilteredOrders());
  }

  function clearDateFilter() {
    document.getElementById("orderFromDate").value = "";
    document.getElementById("orderToDate").value = "";
    applyOrderFilters();
  }

  function renderOrdersTable(orders) {
    lastOrdersView = orders;
    const el = document.getElementById("order-list");
    const statuses = ["UNPAID", "CONFIRMED", "SHIPPED", "DELIVERED", "CANCELLED"];

    if (!Array.isArray(orders) || orders.length === 0) {
      el.innerHTML = `<div class="empty-state"><i class="bi bi-receipt empty-icon"></i><p>No orders found.</p></div>`;
      document.getElementById("orders-pagination").innerHTML = "";
      return;
    }

    const totalPages = Math.max(1, Math.ceil(orders.length / PAGE_SIZE));
    if (ordersPage > totalPages) ordersPage = totalPages;
    const start = (ordersPage - 1) * PAGE_SIZE;
    const pageItems = orders.slice(start, start + PAGE_SIZE);

    el.innerHTML = `
      <table class="table-app">
        <thead><tr>
          <th><input type="checkbox" class="select-checkbox" onchange="toggleAllOrders(this.checked)"></th>
          <th>Order ID</th><th>Customer</th><th>Amount</th><th>Status</th><th>Date</th>
        </tr></thead>
        <tbody>
          ${pageItems.map(o => `
            <tr>
              <td data-label="Select"><input type="checkbox" class="select-checkbox order-checkbox" value="${o.order_id}" onchange="updateOrdersBulkBar()"></td>
              <td data-label="Order ID" class="order-row-clickable" onclick="openOrderModal('${o.order_id}')">${o.order_id}</td>
              <td data-label="Customer" class="order-row-clickable" onclick="openOrderModal('${o.order_id}')">${o.customer.name}<br><span style="font-size:12px; color:var(--color-text-muted);">${o.customer.email}</span></td>
              <td data-label="Amount" class="order-row-clickable" onclick="openOrderModal('${o.order_id}')">₹${o.amount}</td>
              <td data-label="Status">
                <select class="form-select form-select-sm status-select" data-status="${o.status}" style="width:auto;" onclick="event.stopPropagation()" onchange="updateStatus('${o.order_id}', this.value); this.setAttribute('data-status', this.value)">
                  ${statuses.map(s => `<option value="${s}" ${s === o.status ? "selected" : ""}>${s}</option>`).join("")}
                </select>
              </td>
              <td data-label="Date" class="order-row-clickable" onclick="openOrderModal('${o.order_id}')">${new Date(o.date).toLocaleString()}</td>
            </tr>
          `).join("")}
        </tbody>
      </table>
    `;
    updateOrdersBulkBar();
    renderPagination("orders-pagination", orders.length, ordersPage, (p) => { ordersPage = p; renderOrdersTable(orders); });
  }

  function toggleAllOrders(checked) {
    document.querySelectorAll(".order-checkbox").forEach(cb => cb.checked = checked);
    updateOrdersBulkBar();
  }

  function updateOrdersBulkBar() {
    const checked = document.querySelectorAll(".order-checkbox:checked");
    const bar = document.getElementById("orders-bulk-bar");
    document.getElementById("orders-selected-count").textContent = checked.length + " selected";
    bar.classList.toggle("visible", checked.length > 0);
  }

  async function deleteSelectedOrders() {
    const ids = [...document.querySelectorAll(".order-checkbox:checked")].map(cb => cb.value);
    if (ids.length === 0) return;
    if (!confirm(`Delete ${ids.length} selected order(s)? This cannot be undone.`)) return;

    await fetch("/api/admin/orders", {
      method: "DELETE",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ ids })
    });
    loadOrders();
  }

  let currentModalOrderId = null;

  function openOrderModal(orderId) {
    const o = allOrders.find(x => x.order_id === orderId);
    if (!o) return;
    currentModalOrderId = orderId;

    let grandTotal = 0;
    const rows = o.items.map(i => {
      const lineTotal = i.price * i.qty;
      grandTotal += lineTotal;
      return `<tr><td data-label="Product">${i.name}</td><td data-label="Size">${i.size}</td><td data-label="Qty">${i.qty}</td><td data-label="Price">₹${i.price}</td><td data-label="Total">₹${lineTotal}</td></tr>`;
    }).join("");

    document.getElementById("orderModalBody").innerHTML = `
      <h5>Order #${o.order_id}</h5>
      <p style="margin-bottom: var(--space-1);"><strong>Customer Info:</strong></p>
      <p style="margin:0;">Name: ${o.customer.name}</p>
      <p style="margin:0;">Email: ${o.customer.email}</p>
      <p style="margin:0;">Phone: ${o.customer.phone || "-"}</p>
      <p style="margin:0;">Address: ${o.customer.address}, ${o.customer.city}, ${o.customer.state}</p>
      <p style="margin:0 0 var(--space-2);">Date: ${new Date(o.date).toLocaleString()}</p>
      <p style="margin-bottom: var(--space-3); display:flex; align-items:center; gap: var(--space-2);">
        Status:
        <select class="form-select form-select-sm status-select" data-status="${o.status}" style="width:auto;" id="modal-status-select"
                onchange="updateStatusFromModal('${o.order_id}', this.value); this.setAttribute('data-status', this.value)">
          ${["UNPAID","CONFIRMED","SHIPPED","DELIVERED","CANCELLED"].map(s => `<option value="${s}" ${s === o.status ? "selected" : ""}>${s}</option>`).join("")}
        </select>
      </p>
      <p style="margin-bottom: var(--space-1);"><strong>Items:</strong></p>
      <table class="table-app">
        <thead><tr><th>Product</th><th>Size</th><th>Qty</th><th>Price</th><th>Total</th></tr></thead>
        <tbody>${rows}</tbody>
        <tfoot><tr><td colspan="4" style="text-align:right; font-weight:700;">Grand Total</td><td style="font-weight:700;">₹${grandTotal}</td></tr></tfoot>
      </table>
      <div class="d-flex gap-2 flex-wrap" style="margin-top: var(--space-3);">
        <button class="btn btn-secondary btn-sm" onclick="emailInvoice('${o.order_id}')"><i class="bi bi-envelope"></i> Email Invoice</button>
        <button class="btn btn-secondary btn-sm" onclick="viewInvoice('${o.order_id}')"><i class="bi bi-receipt-cutoff"></i> View Invoice</button>
        <button class="btn btn-secondary btn-sm" onclick="showPaymentQR('${o.order_id}')"><i class="bi bi-qr-code"></i> Payment QR</button>
        <button class="btn btn-secondary btn-sm" onclick="sendWhatsAppReminder('${o.order_id}')"><i class="bi bi-whatsapp"></i> WhatsApp Reminder</button>
      </div>
      <div id="order-action-result" style="margin-top: var(--space-2);"></div>
    `;

    const modalEl = document.getElementById("orderModal");
    if (!orderModalInstance) orderModalInstance = new bootstrap.Modal(modalEl);
    orderModalInstance.show();
  }

  async function emailInvoice(orderId) {
    const resultEl = document.getElementById("order-action-result");
    resultEl.innerHTML = `<div class="alert alert-info">Sending invoice...</div>`;
    const res = await fetch("/api/admin/send-invoice", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ order_id: orderId })
    });
    const data = await res.json();
    resultEl.innerHTML = data.success
      ? `<div class="alert alert-success">Invoice emailed to customer.</div>`
      : `<div class="alert alert-danger">${data.error || "Could not send invoice"}</div>`;
  }

  function viewInvoice(orderId) {
    window.open(`/admin/invoice/?order_id=${encodeURIComponent(orderId)}`, "_blank");
  }

  function showPaymentQR(orderId) {
    const o = allOrders.find(x => x.order_id === orderId);
    if (!o) return;
    const upiUri = `upi://pay?pa={{ site.upiId }}&pn=${encodeURIComponent("{{ site.upiPayeeName }}")}&am=${o.amount}&cu=INR&tn=${encodeURIComponent("Order " + orderId)}`;
    const qrImgUrl = `https://api.qrserver.com/v1/create-qr-code/?size=300x300&bgcolor=ffffff&color=000000&margin=10&data=${encodeURIComponent(upiUri)}`;

    const win = window.open("", "_blank");
    win.document.write(`
      <!DOCTYPE html>
      <html><head><title>Payment QR - Order ${orderId}</title>
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <style>
        body { background:#fff; color:#111; font-family: -apple-system, sans-serif; text-align:center; padding: 32px 16px; }
        h2 { margin-bottom: 4px; }
        p { margin: 4px 0; }
        .amount { font-size: 28px; font-weight: 700; margin: 12px 0; }
        img { margin-top: 16px; border: 1px solid #eee; border-radius: 12px; }
      </style></head>
      <body>
        <h2>{{ site.siteName }}</h2>
        <p>Scan to Pay via UPI</p>
        <div class="amount">₹${o.amount}</div>
        <img src="${qrImgUrl}" alt="UPI QR code">
        <p style="margin-top:16px; color:#666; font-size:13px;">Order #${orderId}</p>
      </body></html>
    `);
    win.document.close();
  }

  function sendWhatsAppReminder(orderId) {
    const o = allOrders.find(x => x.order_id === orderId);
    if (!o) return;

    const itemsSummary = o.items.map(i => `${i.name} (${i.size}) x${i.qty}`).join(", ");
    const message = `Hi ${o.customer.name}, this is a reminder for your order #${orderId} - ${itemsSummary}. Total: ₹${o.amount}. Status: ${o.status}. Please complete payment at your earliest convenience. Thank you!`;

    const phone = (o.customer.phone || "").replace(/\D/g, "");
    const url = phone
      ? `https://wa.me/${phone}?text=${encodeURIComponent(message)}`
      : `https://wa.me/?text=${encodeURIComponent(message)}`;

    window.open(url, "_blank");
  }

  async function updateStatus(orderId, status) {
    await fetch("/api/admin/orders", {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ order_id: orderId, status })
    });
    const o = allOrders.find(x => x.order_id === orderId);
    if (o) o.status = status;
  }

  async function updateStatusFromModal(orderId, status) {
    await updateStatus(orderId, status);
    renderOrdersTable(lastOrdersView);
  }

  document.getElementById("orderSearchInput").addEventListener("input", () => applyOrderFilters());

  function clearOrderSearch() {
    document.getElementById("orderSearchInput").value = "";
    applyOrderFilters();
  }

  // ---- Store settings ----
  async function loadSettings() {
    const res = await fetch("/api/admin/settings");
    const s = await res.json();
    document.getElementById("s-name").value = s.name || "";
    document.getElementById("s-address").value = s.address || "";
    document.getElementById("s-gstin").value = s.gstin || "";
    document.getElementById("s-mobile").value = s.mobile || "";
    document.getElementById("s-email").value = s.email || "";
    document.getElementById("s-inventory").checked = !!s.inventoryEnabled;
    document.getElementById("s-gst").checked = !!s.gstEnabled;
  }

  document.getElementById("settings-form").addEventListener("submit", async (e) => {
    e.preventDefault();
    const resultEl = document.getElementById("settings-result");

    const res = await fetch("/api/admin/settings", {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        name: document.getElementById("s-name").value,
        address: document.getElementById("s-address").value,
        gstin: document.getElementById("s-gstin").value,
        mobile: document.getElementById("s-mobile").value,
        email: document.getElementById("s-email").value,
        inventoryEnabled: document.getElementById("s-inventory").checked,
        gstEnabled: document.getElementById("s-gst").checked
      })
    });
    const data = await res.json();
    resultEl.innerHTML = data.success
      ? `<div class="alert alert-success">Settings saved.</div>`
      : `<div class="alert alert-danger">${data.error || "Could not save"}</div>`;
  });

  loadCategories();
  loadProducts();
  loadOrders();
  loadSettings();
</script>
