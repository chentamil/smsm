---
title: Cart & Checkout
layout: base.njk
---
<h1>Your Cart</h1>

<div id="cart-items" class="stack-md" style="margin-bottom: var(--space-4);"></div>

<div class="surface-card">
  <div style="display:flex; justify-content:space-between;">
    <span>Subtotal</span>
    <span>₹<span id="cart-subtotal">0</span></span>
  </div>
  <div id="cart-gst-row" style="display:none; justify-content:space-between; margin-top:4px;">
    <span>GST</span>
    <span>₹<span id="cart-gst">0</span></span>
  </div>
  <hr>
  <div style="display:flex; justify-content:space-between; align-items:center;">
    <span style="font-weight:600;">Total</span>
    <span style="font-family:var(--font-display); font-weight:700; font-size:18px;">₹<span id="cart-total">0</span></span>
  </div>
</div>

<h2 style="margin-top: var(--space-5);">Delivery Details</h2>
<form id="checkout-form" class="surface-card">
  <div class="form-field">
    <label class="form-label" for="c-name">Full name</label>
    <input type="text" class="form-control" id="c-name" required>
  </div>
  <div class="form-field">
    <label class="form-label" for="c-email">Email</label>
    <input type="email" class="form-control" id="c-email" required>
  </div>
  <div class="form-field">
    <label class="form-label" for="c-phone">Phone (with country code, e.g. 91XXXXXXXXXX)</label>
    <input type="tel" class="form-control" id="c-phone" required>
  </div>
  <div class="form-field">
    <label class="form-label" for="c-address">Address</label>
    <input type="text" class="form-control" id="c-address" required>
  </div>
  <div class="row g-2">
    <div class="col-6 form-field">
      <label class="form-label" for="c-city">City</label>
      <input type="text" class="form-control" id="c-city" required>
    </div>
    <div class="col-6 form-field">
      <label class="form-label" for="c-state">State</label>
      <input type="text" class="form-control" id="c-state" required>
    </div>
  </div>

  <!-- Honeypot - hidden from real users, bots tend to fill every field -->
  <input type="text" id="website" name="website" autocomplete="off" tabindex="-1"
         style="position:absolute; left:-9999px; width:1px; height:1px;" aria-hidden="true">

  <!-- 🔧 REPLACE "YOUR_TURNSTILE_SITE_KEY" below with your real site key -->
  <div class="cf-turnstile" data-sitekey="0x4AAAAAAD8QTWA3w68uFiB1" style="margin: var(--space-3) 0;"></div>

  <button type="submit" class="btn btn-primary btn-block" id="placeOrderBtn">Place Order (Cash on Delivery)</button>
</form>

<div id="order-result" style="margin-top: var(--space-3);"></div>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<style>
  .cart-row {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: var(--shadow-sm);
  }
  .cart-row .cart-row-name { font-weight: 600; font-size: 14px; }
  .cart-row .cart-row-meta { font-size: 12px; color: var(--color-text-muted); }
</style>

<script>
  // Cart is stored as an object keyed "${id}-${size}" -> {product, size, qty, price}
  // (matches the catalog page's model)
  let productGstMap = {};

  fetch("/api/products").then(r => r.json()).then(products => {
    if (Array.isArray(products)) {
      products.forEach(p => productGstMap[p.id] = p.gstPercent || 0);
    }
    renderCart();
  }).catch(() => renderCart());

  function getCart() {
    return JSON.parse(localStorage.getItem("cart") || "{}");
  }
  function saveCart(cart) {
    localStorage.setItem("cart", JSON.stringify(cart));
    document.dispatchEvent(new Event("cart:updated"));
  }
  function cartAsItemsArray(cart) {
    return Object.values(cart).map(c => ({
      productId: c.product.id,
      name: c.product.name,
      size: c.size,
      price: c.price,
      qty: c.qty
    }));
  }

  // Live estimate only - order.js always recalculates authoritatively from
  // the database, so this is purely for display before the order is placed.
  function estimateTotals(cart) {
    let subtotal = 0;
    let gst = 0;
    Object.values(cart).forEach(c => {
      const lineSubtotal = c.price * c.qty;
      const gstPercent = productGstMap[c.product.id] || 0;
      subtotal += lineSubtotal;
      gst += lineSubtotal * gstPercent / 100;
    });
    return { subtotal: Math.round(subtotal), gst: Math.round(gst), total: Math.round(subtotal + gst) };
  }

  function renderCart() {
    const cart = getCart();
    const el = document.getElementById("cart-items");
    const keys = Object.keys(cart);

    if (keys.length === 0) {
      el.innerHTML = `
        <div class="empty-state">
          <div class="empty-icon"><i class="bi bi-cart"></i></div>
          <p>Your cart is empty.</p>
          <a href="/catalog/" class="btn btn-outline-primary btn-sm">Browse products</a>
        </div>`;
      document.getElementById("cart-subtotal").textContent = "0";
      document.getElementById("cart-total").textContent = "0";
      document.getElementById("cart-gst-row").style.display = "none";
      return;
    }

    el.innerHTML = keys.map(key => {
      const c = cart[key];
      return `
        <div class="cart-row">
          <div>
            <div class="cart-row-name">${c.product.name}</div>
            <div class="cart-row-meta">${c.size} · Qty ${c.qty} · ₹${c.price * c.qty}</div>
          </div>
          <button class="btn btn-secondary btn-sm" onclick="removeItem('${key}')"><i class="bi bi-trash"></i></button>
        </div>`;
    }).join("");

    const totals = estimateTotals(cart);
    document.getElementById("cart-subtotal").textContent = totals.subtotal;
    document.getElementById("cart-total").textContent = totals.total;
    const gstRow = document.getElementById("cart-gst-row");
    if (totals.gst > 0) {
      gstRow.style.display = "flex";
      document.getElementById("cart-gst").textContent = totals.gst;
    } else {
      gstRow.style.display = "none";
    }
  }

  function removeItem(key) {
    const cart = getCart();
    delete cart[key];
    saveCart(cart);
    renderCart();
  }

  document.getElementById("checkout-form").addEventListener("submit", async (e) => {
    e.preventDefault();

    const cart = getCart();
    if (Object.keys(cart).length === 0) {
      alert("Your cart is empty.");
      return;
    }

    // Honeypot check - if this hidden field got filled, silently bail
    if (document.getElementById("website").value !== "") return;

    const turnstileToken = document.querySelector('[name="cf-turnstile-response"]')?.value;
    if (!turnstileToken) {
      alert("Please complete the captcha check.");
      return;
    }

    const customer = {
      name: document.getElementById("c-name").value,
      email: document.getElementById("c-email").value,
      phone: document.getElementById("c-phone").value,
      address: document.getElementById("c-address").value,
      city: document.getElementById("c-city").value,
      state: document.getElementById("c-state").value
    };

    const btn = document.getElementById("placeOrderBtn");
    const resultEl = document.getElementById("order-result");
    btn.disabled = true;
    btn.textContent = "Processing...";
    resultEl.innerHTML = `<div class="alert alert-info">Placing order...</div>`;

    try {
      const res = await fetch("/api/order", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ customer, items: cartAsItemsArray(cart), turnstileToken })
      });
      const data = await res.json();

      if (data.success) {
        const orderedItems = cartAsItemsArray(cart);
        localStorage.removeItem("cart");
        document.dispatchEvent(new Event("cart:updated"));
        document.getElementById("cart-items").innerHTML = "";
        document.getElementById("checkout-form").style.display = "none";
        renderReceipt(data.order_id, customer, orderedItems, data.subtotal, data.gstAmount, data.amount);
      } else {
        resultEl.innerHTML = `<div class="alert alert-danger">Order failed: ${data.error || "unknown error"}</div>`;
        btn.disabled = false;
        btn.textContent = "Place Order (Cash on Delivery)";
      }
    } catch (err) {
      resultEl.innerHTML = `<div class="alert alert-danger">Order failed. Check console.</div>`;
      console.error(err);
      btn.disabled = false;
      btn.textContent = "Place Order (Cash on Delivery)";
    }
  });

  // ---- Receipt: UPI QR code, amount in words, printable ----
  function renderReceipt(orderId, customer, items, subtotal, gstAmount, amount) {
    const resultEl = document.getElementById("order-result");

    const itemRows = items.map(i => `
      <tr>
        <td data-label="Item">${i.name} (${i.size})</td>
        <td data-label="Qty">${i.qty}</td>
        <td data-label="Total">₹${i.price * i.qty}</td>
      </tr>`).join("");

    const gstLine = gstAmount > 0 ? `
      <div style="display:flex; justify-content:space-between; font-size:13px; color:var(--color-text-muted);">
        <span>GST</span><span>₹${gstAmount}</span>
      </div>` : "";

    resultEl.innerHTML = `
      <div class="alert alert-success">Order placed! A confirmation email has been sent.</div>

      <div class="receipt-card" id="receipt">
        <h3 style="margin-bottom:0;">{{ site.siteName }}</h3>
        <p style="font-size:12px; color:var(--color-text-muted); margin-bottom:var(--space-3);">Order Receipt</p>

        <p style="margin:0;"><strong>Order ID:</strong> ${orderId}</p>
        <p style="margin:0;"><strong>Name:</strong> ${customer.name}</p>
        <p style="margin:0;"><strong>Delivery:</strong> ${customer.address}, ${customer.city}, ${customer.state}</p>
        <p style="margin:0 0 var(--space-3);"><strong>Date:</strong> ${new Date().toLocaleString()}</p>

        <table class="table-app">
          <thead><tr><th>Item</th><th>Qty</th><th>Total</th></tr></thead>
          <tbody>${itemRows}</tbody>
        </table>

        <div style="margin-top:var(--space-2);">
          <div style="display:flex; justify-content:space-between; font-size:13px; color:var(--color-text-muted);">
            <span>Subtotal</span><span>₹${subtotal}</span>
          </div>
          ${gstLine}
          <div style="display:flex; justify-content:space-between; font-weight:700; margin-top:4px;">
            <span>Grand Total</span><span>₹${amount}</span>
          </div>
        </div>

        <p class="receipt-words">Amount in words: ${amountToWords(amount)} only</p>

        <div class="receipt-qr">
          <button class="btn btn-outline-primary btn-sm" type="button" onclick="openPaymentQR(${amount}, '${orderId}')">
            <i class="bi bi-qr-code"></i> View Payment QR
          </button>
          <p style="font-size:12px; color:var(--color-text-muted); margin-top:var(--space-1);">Scan to pay via UPI (optional - order is confirmed as Cash on Delivery)</p>
        </div>
      </div>

      <div id="order-result-actions" class="d-flex gap-2" style="margin-top: var(--space-3);">
        <button class="btn btn-secondary btn-block" onclick="window.print()"><i class="bi bi-printer"></i> Print Receipt</button>
        <a href="/catalog/" class="btn btn-primary btn-block">Continue Shopping</a>
      </div>
    `;
  }

  // Opens the UPI QR in a clean, white-background tab with shop name and
  // amount clearly labeled (a bare image in a new tab can look black in
  // dark-mode browsers, which makes it hard to scan).
  function openPaymentQR(amount, orderId) {
    const upiUri = `upi://pay?pa={{ site.upiId }}&pn=${encodeURIComponent("{{ site.upiPayeeName }}")}&am=${amount}&cu=INR&tn=${encodeURIComponent("Order " + orderId)}`;
    const qrImgUrl = `https://api.qrserver.com/v1/create-qr-code/?size=300x300&bgcolor=ffffff&color=000000&margin=10&data=${encodeURIComponent(upiUri)}`;

    const win = window.open("", "_blank");
    win.document.write(`
      <!DOCTYPE html>
      <html><head><title>Payment QR - Order ${orderId}</title>
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <style>
        body { background:#fff; color:#111; font-family: -apple-system, sans-serif; text-align:center; padding: 32px 16px; }
        h2 { margin-bottom: 4px; }
        p { margin: 4px 0; }
        .amount { font-size: 28px; font-weight: 700; margin: 12px 0; }
        img { margin-top: 16px; border: 1px solid #eee; border-radius: 12px; }
      </style></head>
      <body>
        <h2>{{ site.siteName }}</h2>
        <p>Scan to Pay via UPI</p>
        <div class="amount">₹${amount}</div>
        <img src="${qrImgUrl}" alt="UPI QR code">
        <p style="margin-top:16px; color:#666; font-size:13px;">Order #${orderId}</p>
      </body></html>
    `);
    win.document.close();
  }

  // Indian numbering system (lakh/crore) amount-in-words converter
  function amountToWords(num) {
    num = Math.round(Number(num));
    if (num === 0) return "Zero Rupees";

    const ones = ["", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine",
      "Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen", "Sixteen", "Seventeen", "Eighteen", "Nineteen"];
    const tens = ["", "", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy", "Eighty", "Ninety"];

    function twoDigits(n) {
      if (n < 20) return ones[n];
      return tens[Math.floor(n / 10)] + (n % 10 ? " " + ones[n % 10] : "");
    }
    function threeDigits(n) {
      if (n < 100) return twoDigits(n);
      return ones[Math.floor(n / 100)] + " Hundred" + (n % 100 ? " " + twoDigits(n % 100) : "");
    }

    let crore = Math.floor(num / 10000000);
    let lakh = Math.floor((num % 10000000) / 100000);
    let thousand = Math.floor((num % 100000) / 1000);
    let rest = num % 1000;

    let words = "";
    if (crore) words += threeDigits(crore) + " Crore ";
    if (lakh) words += threeDigits(lakh) + " Lakh ";
    if (thousand) words += threeDigits(thousand) + " Thousand ";
    if (rest) words += threeDigits(rest);

    return "Rupees " + words.trim();
  }
</script>
