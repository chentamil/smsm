---
title: Invoice
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Invoice · {{ site.siteName }}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/assets/css/theme.css" rel="stylesheet">
  <style>
    body { background: var(--color-bg); padding: var(--space-4); }
    .invoice-wrap { max-width: 640px; margin: 0 auto; }
  </style>
</head>
<body>
  <div class="invoice-wrap" id="invoice-content">
    <p>Loading invoice...</p>
  </div>

  <script>
    const params = new URLSearchParams(window.location.search);
    const orderId = params.get("order_id");

    async function loadInvoice() {
      const el = document.getElementById("invoice-content");
      if (!orderId) {
        el.innerHTML = `<div class="alert alert-danger">No order_id provided.</div>`;
        return;
      }

      try {
        const res = await fetch("/api/admin/orders");
        if (res.status === 401) {
          window.location.href = "/admin-login/";
          return;
        }
        const orders = await res.json();
        const o = orders.find(x => x.order_id === orderId);

        if (!o) {
          el.innerHTML = `<div class="alert alert-danger">Order not found.</div>`;
          return;
        }

        const rows = o.items.map(i => `
          <tr>
            <td data-label="Product">${i.name}</td>
            <td data-label="Size">${i.size}</td>
            <td data-label="Qty">${i.qty}</td>
            <td data-label="Price">₹${i.price}</td>
            <td data-label="Total">₹${i.price * i.qty}</td>
          </tr>`).join("");

        const gstLine = o.gstAmount > 0 ? `
          <div style="display:flex; justify-content:space-between; font-size:14px;">
            <span>GST</span><span>₹${o.gstAmount}</span>
          </div>` : "";

        el.innerHTML = `
          <div class="receipt-card">
            <h2 style="margin-bottom:0;">{{ site.siteName }}</h2>
            <p style="font-size:12px; color:var(--color-text-muted); margin-bottom:var(--space-3);">Invoice</p>

            <p style="margin:0;"><strong>Order ID:</strong> ${o.order_id}</p>
            <p style="margin:0;"><strong>Name:</strong> ${o.customer.name}</p>
            <p style="margin:0;"><strong>Email:</strong> ${o.customer.email}</p>
            <p style="margin:0;"><strong>Phone:</strong> ${o.customer.phone || "-"}</p>
            <p style="margin:0;"><strong>Address:</strong> ${o.customer.address}, ${o.customer.city}, ${o.customer.state}</p>
            <p style="margin:0;"><strong>Date:</strong> ${new Date(o.date).toLocaleString()}</p>
            <p style="margin:0 0 var(--space-3);"><strong>Status:</strong> <span class="badge" data-status="${o.status}">${o.status}</span></p>

            <table class="table-app">
              <thead><tr><th>Product</th><th>Size</th><th>Qty</th><th>Price</th><th>Total</th></tr></thead>
              <tbody>${rows}</tbody>
            </table>

            <div style="margin-top:var(--space-3);">
              <div style="display:flex; justify-content:space-between; font-size:14px;">
                <span>Subtotal</span><span>₹${o.subtotal}</span>
              </div>
              ${gstLine}
              <div style="display:flex; justify-content:space-between; font-weight:700; margin-top:4px; font-size:16px;">
                <span>Grand Total</span><span>₹${o.amount}</span>
              </div>
            </div>
          </div>

          <div style="margin-top: var(--space-3);">
            <button class="btn btn-primary btn-block" onclick="window.print()"><i class="bi bi-printer"></i> Print</button>
          </div>
        `;
      } catch (err) {
        el.innerHTML = `<div class="alert alert-danger">Could not load invoice.</div>`;
        console.error(err);
      }
    }

    loadInvoice();
  </script>
</body>
</html>
